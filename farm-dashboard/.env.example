# ─────────────────────────────────────────────────────────────────────────────
# Leks' Farm Notification Server — Environment Variables
# Copy this file to .env and fill in your credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (default: 3001)
PORT=3001

# ── MQTT Broker (online data connection) ─────────────────────────────────────
# Defaults to the free public EMQX broker (broker.emqx.io) — no setup needed,
# data flows over the internet between sensors, server, and dashboard.
# Backend/simulator/hardware use MQTT over TLS (port 8883 — plain 1883 is
# blocked on many networks); the browser must use WebSockets
# (wss:// when the dashboard is served over HTTPS, e.g. on Render).
MQTT_URL=mqtts://broker.emqx.io:8883
VITE_SERVER_URL=https://your-app-domain.example
VITE_MQTT_URL=wss://broker.emqx.io:8084/mqtt

# Public brokers are shared by everyone — change this to something unique to
# your farm so you never receive someone else's data (all parts must match).
MQTT_TOPIC_BASE=leksfarm/pond1
VITE_MQTT_TOPIC_BASE=leksfarm/pond1

# ── Alert cooldown (minutes between repeat alerts for the same rule) ──────────
COOLDOWN_MINUTES=10

# ── Keep-alive ping (stops free hosting from putting the server to sleep) ────
# On Render this is automatic (RENDER_EXTERNAL_URL is set for you).
# Elsewhere, set KEEP_ALIVE_URL to the server's own public URL to enable.
# KEEP_ALIVE_URL=https://your-app-domain.example
KEEP_ALIVE_MINUTES=10

# ── Default alert recipients (used by server-side MQTT listener) ─────────────
# These are used when alerts are triggered server-side (no browser open).
# The dashboard can also send its own recipients via the Settings page.
ALERT_PHONE=+447911123456
ALERT_EMAIL=you@example.com
ALERT_WHATSAPP=+447911123456
ALERT_TELEGRAM_CHAT_ID=123456789

# ── Google Sheets logging (optional) ─────────────────────────────────────────
# Streams one row of readings per minute into a Google Sheet for a permanent
# archive. See README "Data Logging & Export" for the 5-minute Apps Script setup.
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# ── Telegram (free forever, recommended) ─────────────────────────────────────
# 1. In Telegram, message @BotFather → /newbot → follow prompts → copy the token
# 2. Send your new bot any message (so it is allowed to reply to you)
# 3. Use "Detect my Chat ID" on the dashboard Settings page, or open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio (SMS) ──────────────────────────────────────────────────────────────
# Sign up free at https://twilio.com — includes $15 free credit
# Free trial lets you send to verified numbers only.
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=+15017122661    # Your Twilio phone number

# ── Brevo (Email) ─────────────────────────────────────────────────────────────
# Sign up free at https://app.brevo.com — 300 emails/day free forever
# Create API key at: Account → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=alerts@yourdomain.com
BREVO_FROM_NAME=Leks' Catfish Farm

# ── Whapi.Cloud (WhatsApp) ────────────────────────────────────────────────────
# Sign up free at https://whapi.cloud — free sandbox forever
# 1. Create account → Create Channel → Scan QR code with your WhatsApp
# 2. Copy the Bearer token and channel URL below
WHAPI_TOKEN=your_whapi_bearer_token_here
WHAPI_CHANNEL_URL=https://gate.whapi.cloud   # Your channel URL from dashboard